          "name": "Get a List of Facts",
          "request": {
            "name": "Get a List of Facts",
            "description": {
              "content": "Returns a paginated list of cat facts. Supports max_length (character cap per fact) and limit (page size) query parameters. The response follows Laravel's paginator format with current_page, per_page, total, last_page, links, and a data array of CatFact objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "facts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "max_length",
                  "value": "<integer>",
                  "description": "Maximum length, in characters, of each returned fact."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of facts to return per page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
