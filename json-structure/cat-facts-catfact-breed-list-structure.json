{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/cat-facts-catfact/refs/heads/main/json-structure/cat-facts-catfact-breed-list-structure.json",
  "name": "BreedList",
  "description": "Laravel-style paginated wrapper around a list of Breed objects.",
  "type": "object",
  "properties": {
    "current_page": { "type": "int32", "example": 1 },
    "data": {
      "type": "array",
      "items": { "$ref": "cat-facts-catfact-breed-structure.json" }
    },
    "first_page_url": { "type": "uri", "example": "https://catfact.ninja/breeds?page=1" },
    "from": { "type": "int32", "example": 1 },
    "last_page": { "type": "int32", "example": 49 },
    "last_page_url": { "type": "uri", "example": "https://catfact.ninja/breeds?page=49" },
    "links": {
      "type": "array",
      "items": { "$ref": "cat-facts-catfact-pagination-link-structure.json" }
    },
    "next_page_url": { "type": "uri", "example": "https://catfact.ninja/breeds?page=2" },
    "path": { "type": "uri", "example": "https://catfact.ninja/breeds" },
    "per_page": { "type": "int32", "example": 10 },
    "prev_page_url": { "type": "uri", "example": null },
    "to": { "type": "int32", "example": 10 },
    "total": { "type": "int32", "example": 98 }
  }
}
